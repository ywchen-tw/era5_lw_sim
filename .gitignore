# -- data-format files anywhere (safety net beyond the folders above) -------
*.nc
*.tab
*.csv
*.dat
*.npy
*.npz
*.grib
*.zip
*.h5
*.hdf5

# -- credentials & local state (never commit) -------------------------------
.cdsapirc
*.key
.env
randomseed

# -- job logs, caches, OS cruft ---------------------------------------------
*.out
*.log
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# macOS AppleDouble files on external volumes
._*
